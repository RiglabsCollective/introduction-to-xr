  InputLines:
    - '// @input Component.Camera camera {"hint":"The camera every label turns to face (usually Camera Object)."}'
    - '// @input SceneObject centerObject {"hint":"The centre of the face or object. Labels fan out sideways away from it."}'
    - '// @input Asset.Font font {"hint":"The font used for every label. Leave it empty to use the default font."}'
    - '// @input Asset.Material labelMaterial {"hint":"The material used for every label. Leave it empty for the default text material."}'
    - '// @input float fontSize = 48 {"hint":"Font size of the label text."}'
    - '// @input float labelScale = 0.4 {"hint":"Size of every label in the world. Raise it to make all the labels bigger."}'
