# Same line endings on Windows and macOS: Git stores LF, each OS checks out what it needs
* text=auto

# Lens Studio text files: always LF so diffs stay clean across Windows and macOS
*.esproj text eol=lf
*.meta text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ss_graph text eol=lf

# Binary files: never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary

# 3D models, media and exported lenses: binary, stored as normal Git files
# (no Git LFS, so "Download ZIP" on GitHub gives participants the real files)
*.fbx binary
*.obj binary
*.glb binary
*.gltf binary
*.hdr binary
*.exr binary
*.psd binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.onnx binary
*.lspkg binary
*.lns binary
*.tga binary
